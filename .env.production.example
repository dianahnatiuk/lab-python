APP_ENV=production
DEBUG=false

# Docker Compose (інші порти, щоб sandbox і production могли працювати одночасно)
ENV_FILE=.env.production
API_PORT=8001
POSTGRES_PORT=5433
MONGO_PORT=27018

# Бази production (окремі від sandbox)
POSTGRES_USER=medlab_prod
POSTGRES_PASSWORD=change-me-production-db
POSTGRES_DB=medlab_prod
MONGO_USER=medlab_prod
MONGO_PASSWORD=change-me-production-mongo
MONGO_DB=medlab_prod

# Автентифікація (унікальний довгий JWT_SECRET)
JWT_SECRET=change-me-generate-with-secrets-token-hex-32
# true, якщо перед застосунком стоїть HTTPS
COOKIE_SECURE=false
ADMIN_EMAIL=admin@medlab.com
ADMIN_PASSWORD=change-me-production-admin
