APP_ENV=sandbox
DEBUG=false

# Docker Compose
ENV_FILE=.env.sandbox
API_PORT=8000
POSTGRES_PORT=5432
MONGO_PORT=27017

# Бази sandbox (окремі від production)
POSTGRES_USER=medlab_sandbox
POSTGRES_PASSWORD=change-me-sandbox-db
POSTGRES_DB=medlab_sandbox
MONGO_USER=medlab_sandbox
MONGO_PASSWORD=change-me-sandbox-mongo
MONGO_DB=medlab_sandbox

# Автентифікація (JWT_SECRET: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-generate-with-secrets-token-hex-32
COOKIE_SECURE=false
ADMIN_EMAIL=admin@medlab.com
ADMIN_PASSWORD=change-me-sandbox-admin
